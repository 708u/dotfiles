{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Artifact|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:$PATH\" bun \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.ts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/textlint.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
