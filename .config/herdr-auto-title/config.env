# herdr-auto-title の設定。起動時に 1 回だけ読み込むため、変更後は
# herdr plugin action invoke herdr.auto-title.restart で再起動する

# タブの位置の番号は prefix+1..9 の switch_tab に対応させる想定だが、
# prefix+1..9 は focus_agent に割り当てて switch_tab を無効にしているため付けない
HERDR_AUTO_TITLE_POSITION=false

HERDR_AUTO_TITLE_AGENT_STATUS=true

HERDR_AUTO_TITLE_ICONS=true

# agent の横に editor などを開いてフォーカスを移しても、タブ名は agent の作業内容のままにする
HERDR_AUTO_TITLE_PREFER_AGENT=true
